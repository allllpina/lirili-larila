# AUTH
GOOGLE_CLIENT_ID= # Can be copied from Google Cloud Console (APIs and Services -> credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_SECRET= # Can be copied from Google Cloud Console (APIs and Services -> credentials -> OAuth 2.0 Client IDs)
JWT_KEY= # Random secret to create JWTs
ALGORITHM= # Just put HS265

SESSION_MIDDLEWARE_SECRET= # Same as JWT secret, just generate something

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST= # In local deployment just use db-users
POSTGRES_PORT= # 5432 by default

FRONTEND_URL= # For local deployment http://localhost:1313, for something more serious just put actual frontend URL (But in this project localhost:1313 stands for nginx, not the frontend)
# FRONTEND
VITE_API_BASE_URL= # For local deployment http://localhost:1313, for something more serious just put actual frontend URL (But in this project localhost:1313 stands for nginx, not the frontend)

# TASKS MSERVICE
DATABASE_HOST= # In local deployment just use db-tasks
DATABASE_PORT= # 27017 by default
DATABASE_NAME=
# Absolutely rudimental block, will not be used in the future
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=
